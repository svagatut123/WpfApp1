<Page x:Class="WpfApp1.pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Панель администратора" Height="500" Width="900">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Управление каталогом стриминговой платформы" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Поиск и сортировка -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="TxtSearch" Width="160" Height="25" TextChanged="TxtSearch_TextChanged" Margin="0,0,15,0"/>

            <TextBlock Text="Сортировка по году:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="ComboSort" Width="150" Height="25" SelectionChanged="ComboSort_SelectionChanged">
                <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                <ComboBoxItem Content="Сначала новые"/>
                <ComboBoxItem Content="Сначала старые"/>
            </ComboBox>
        </StackPanel>

        <!-- Таблица -->
        <DataGrid x:Name="DataGridContent" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ContentID}" Width="40"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="170"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding ContentType}" Width="80"/>
                <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="100"/>
                <DataGridTextColumn Header="Длит." Binding="{Binding DurationMinutes}" Width="60"/>
                <DataGridTextColumn Header="Год" Binding="{Binding ReleaseYear}" Width="50"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопки управления (включая кнопку смены пароля) -->
        <WrapPanel Grid.Row="3" Orientation="Horizontal">
            <Button Content="Добавить" Width="90" Height="30" Click="BtnAdd_Click" Margin="0,0,10,0" Background="#0198AF" Foreground="White" FontWeight="Bold"/>
            <Button Content="Редактировать" Width="110" Height="30" Click="BtnEdit_Click" Margin="0,0,10,0"/>
            <Button Content="Удалить" Width="90" Height="30" Click="BtnDelete_Click" Margin="0,0,10,0" Background="#D9534F" Foreground="White" FontWeight="Bold"/>
            <Button Content="График" Width="80" Height="30" Click="BtnChart_Click" Margin="0,0,10,0"/>
            <Button Content="Экспорт .XLSX" Width="100" Height="30" Click="BtnExportXlsx_Click" Margin="0,0,5,0" Background="#28A745" Foreground="White"/>
            <Button Content="Экспорт .DOCX" Width="100" Height="30" Click="BtnExportDocx_Click" Margin="0,0,5,0" Background="#007BFF" Foreground="White"/>
            <Button Content="Экспорт .PDF" Width="90" Height="30" Click="BtnExportPdf_Click" Margin="0,0,10,0" Background="#6C757D" Foreground="White"/>
            <Button Content="Сменить пароль" Width="110" Height="30" Click="BtnChangePassword_Click" Margin="0,0,20,0"/>
            <Button Content="Выход" Width="80" Height="30" Click="BtnBack_Click"/>
        </WrapPanel>
    </Grid>
</Page>