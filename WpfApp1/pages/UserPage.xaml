<Page x:Class="WpfApp1.pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Каталог контента" Height="480" Width="850">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок с логотипом -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Image Source="/res/Логотип.png" Width="35" Height="35" Margin="0,0,10,0"/>
            <TextBlock Text="Каталог медиаконтента (Пользователь)" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Панель поиска и фильтрации -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="TxtSearch" Width="160" Height="25" TextChanged="Filter_Changed" Margin="0,0,15,0"/>

            <TextBlock Text="Фильтр по типу:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="ComboTypeFilter" Width="140" Height="25" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Все типы" IsSelected="True"/>
                <ComboBoxItem Content="Видео"/>
                <ComboBoxItem Content="Аудио"/>
                <ComboBoxItem Content="Подкаст"/>
            </ComboBox>
        </StackPanel>

        <!-- Таблица данных -->
        <DataGrid x:Name="DataGridContent" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="200"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding ContentType}" Width="90"/>
                <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="110"/>
                <DataGridTextColumn Header="Длит. (мин)" Binding="{Binding DurationMinutes}" Width="80"/>
                <DataGridTextColumn Header="Год" Binding="{Binding ReleaseYear}" Width="60"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Нижняя панель с кнопками -->
        <WrapPanel Grid.Row="3" Orientation="Horizontal">
            <Button Content="Сменить пароль" Width="110" Height="30" Click="BtnChangePassword_Click" Margin="0,0,10,0"/>
            <Button Content="Смена темы" Width="100" Height="30" Click="BtnTheme_Click" Margin="0,0,20,0"/>
            <Button Content="Выход" Width="80" Height="30" Click="BtnBack_Click"/>
        </WrapPanel>
    </Grid>
</Page>