<Page x:Class="WpfApp1.pages.AddEditContentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Добавление контента" Height="500" Width="800">
    <Grid Margin="20">
        <StackPanel Width="350" HorizontalAlignment="Left">
            <TextBlock x:Name="TxtTitleHeader" Text="Добавление медиаконтента" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

            <TextBlock Text="Название:" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtTitle" Height="28" Margin="0,0,0,10"/>

            <TextBlock Text="Тип контента (Видео / Аудио):" Margin="0,0,0,3"/>
            <ComboBox x:Name="ComboType" Height="28" Margin="0,0,0,10">
                <ComboBoxItem Content="Видео"/>
                <ComboBoxItem Content="Аудио"/>
                <ComboBoxItem Content="Подкаст"/>
            </ComboBox>

            <TextBlock Text="Жанр:" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtGenre" Height="28" Margin="0,0,0,10"/>

            <TextBlock Text="Длительность (минут):" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtDuration" Height="28" Margin="0,0,0,10"/>

            <TextBlock Text="Год выпуска:" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtYear" Height="28" Margin="0,0,0,10"/>

            <TextBlock Text="Описание:" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtDescription" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="Сохранить" Width="100" Height="30" Click="BtnSave_Click" Background="#0198AF" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                <Button Content="Отмена" Width="100" Height="30" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>