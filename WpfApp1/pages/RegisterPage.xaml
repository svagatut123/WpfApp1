<Page x:Class="WpfApp1.pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация" Height="450" Width="800">
    <Grid Background="#F3F3F3">
        <Image Source="/res/Логотип.png" Width="140" Height="140" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,10,0"/>
        <StackPanel Width="300" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Регистрация нового пользователя" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" TextAlignment="Center" TextWrapping="Wrap"/>

            <TextBlock Text="ФИО:" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtFullName" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Логин:" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtLogin" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Пароль:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PassBox" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Подтвердите пароль:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PassBoxConfirm" Height="30" Margin="0,0,0,20"/>

            <Button Content="Зарегистрироваться" Click="BtnRegister_Click" Height="35" Background="#0198AF" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>
            <Button Content="Назад к входу" Click="BtnBack_Click" Height="30"/>
        </StackPanel>
    </Grid>
</Page>