<Page x:Class="WpfApp1.pages.ChangePasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Смена пароля" Height="450" Width="800">
    <Grid Background="#F3F3F3">
        <StackPanel Width="300" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Смена пароля" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" TextAlignment="Center"/>

            <TextBlock Text="Старый пароль:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PassOld" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Новый пароль:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PassNew" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Подтвердите новый пароль:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PassConfirm" Height="30" Margin="0,0,0,20"/>

            <Button Content="Изменить пароль" Click="BtnChange_Click" Height="35" Background="#0198AF" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>
            <Button Content="Назад" Click="BtnBack_Click" Height="30"/>
        </StackPanel>
    </Grid>
</Page>